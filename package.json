{
  "name": "envizion-life",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web --port 8082",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --test-isolation=none tests/*.test.ts",
    "build:web": "npm run typecheck && npm test && expo export --platform web && node scripts/prepare-iphone-pwa.mjs",
    "smoke:dist": "node scripts/verify-web-export.mjs",
    "smoke:live": "node scripts/live-smoke.mjs",
    "preflight:native": "node scripts/verify-native-branding.mjs",
    "audit:prod": "npm audit --omit=dev"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.0",
    "@expo-google-fonts/lora": "^0.4.0",
    "@expo/vector-icons": "^15.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.0",
    "@react-navigation/native-stack": "^7.3.0",
    "@supabase/supabase-js": "^2.57.4",
    "expo": "~57.0.30",
    "expo-audio": "~57.0.5",
    "expo-calendar": "~57.0.5",
    "expo-constants": "~57.0.20",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-local-authentication": "~57.0.3",
    "expo-notifications": "~57.0.23",
    "expo-print": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.23",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-qrcode-svg": "6.3.26",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@expo/ngrok": "^4.1.0",
    "@types/react": "~19.2.4",
    "supabase": "2.117.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "postcss": "8.5.28",
    "uuid": "11.1.1",
    "shell-quote": "1.12.0",
    "source-map-js": "1.2.2",
    "undici": "6.29.1",
    "node-forge": "1.4.1"
  }
}
