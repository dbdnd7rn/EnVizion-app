{
  "expo": {
    "name": "EnVizion Life",
    "slug": "envizion-life",
    "version": "0.1.1",
    "icon": "./assets/envizion-app-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/envizion-original.png",
      "resizeMode": "contain",
      "backgroundColor": "#FCF9F6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.envizionlife.caregiver",
      "buildNumber": "2"
    },
    "android": {
      "package": "com.envizionlife.caregiver",
      "versionCode": 2,
      "icon": "./assets/envizion-app-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/envizion-app-icon.png",
        "backgroundColor": "#FCF9F6"
      },
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "bundler": "metro",
      "name": "EnVizion Life | Your care companion",
      "output": "single"
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#7B428E",
          "defaultChannel": "care-updates"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow EnVizion Life to open your calendar so you can add care events you choose."
        }
      ],
      "expo-web-browser"
    ],
    "scheme": "envizionlife",
    "extra": {
      "eas": {
        "projectId": "947baaf0-54d1-44c2-86c5-86c57c6aa11a"
      }
    },
    "owner": "ntonga_victor"
  }
}
