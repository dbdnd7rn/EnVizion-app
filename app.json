{
  "expo": {
    "name": "EnVizion Life",
    "slug": "envizion-life",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.envizionlife.caregiver"
    },
    "android": {
      "package": "com.envizionlife.caregiver"
    },
    "web": {
      "bundler": "metro",
      "name": "EnVizion Life | Your care companion",
      "output": "single"
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#7B428E",
          "defaultChannel": "care-updates"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow EnVizion Life to open your calendar so you can add care events you choose."
        }
      ]
    ],
    "scheme": "envizionlife"
  }
}
